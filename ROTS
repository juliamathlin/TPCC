#Load libraries
library(readxl)
library(edgeR)
library(ROTS)
library(openxlsx)

#Read in the data
data=read_excel("./GSE316750_RawData_XLSX.xlsx")
data=data.frame(data, stringsAsFactors = F)
nas=which(is.na(data), arr.ind = T) #inspect
xx=data[unique(nas[,1]),]
data.num=data[,c(7:ncol(data))]
rownames(data.num)=as.character(data[,1])

# Read clinical data
clinical <- read.csv("./Clinical.csv", sep=";")
clin.data <- clinical
rownames(clin.data) <- as.character(clin.data[,1])

#
dir.create("BvsM_Paired_Analyses")

# Preprocessing
library.sizes=colSums(data.num, na.rm = T)

# For the Benign vs Cancerous tissue - filter away the lowly expressed genes.
cpm.data=edgeR::cpm(data.num, log = F, normalized.library.sizes=F)
locs.count=which(data.matrix(data.num)==10)
counts.10=data.matrix(data.num)[locs.count]
cpm.10=data.matrix(cpm.data)[locs.count]
filt.threshold=max(cpm.10, na.rm = T) 

# change the number to the smallest sample group
totalPatients <- ncol(data.num)/2
keep <- rowSums(edgeR::cpm(data.num, log = F, normalized.library.sizes=F) >= filt.threshold) >= totalPatients
filtered=data.num[!keep,]
data.filt=data.num[keep,] 
filt.library.sizes=colSums(data.filt, na.rm = T)
cor(library.sizes, filt.library.sizes) 

# Normalize
data.norm <- edgeR::calcNormFactors(DGEList(counts=data.filt))
data.norm=edgeR::cpm(data.norm, normalized.lib.sizes=T)
data.norm=log2(data.norm+1)

# Match clinical data to expression data
rownames(clinical) <- clinical[,1]

# Define Benign and Cancer samples
benign.samps <- which(clinical$group == "Benign")
cancer.samps <- which(clinical$group == "Cancer")

# Extract groups
samps.benign <- data.norm[, benign.samps]
samps.cancer <- data.norm[, cancer.samps]


### DE analysis with ROTS
##Paired Analysis
data.for.rots <- cbind(samps.cancer, samps.benign)
groups=c(rep(0,totalPatients), rep(1,totalPatients))

zeros=which(data.norm==0, arr.ind = T)

rots.res<- ROTS(data.for.rots, groups=groups, B=1000,  K = nrow(data.for.rots)/4, seed=1, progress=TRUE, log = T, paired = T)

rots.res.df=data.frame(d=rots.res$d, logfc=rots.res$logfc, pvalue=rots.res$pvalue, fdr=rots.res$FDR)
rots.res.df=rots.res.df[order(as.numeric(rots.res.df$pvalue)),]

write.xlsx(rots.res.df, file = "BvsM_Paired_Analyses/All_GenesTestingForGIT2.xlsx", sheetName = "1", rowNames=TRUE)

save.image("BvsM_Paired_Analyses/1_PreProcessing_Done_ROTS_DE_Done.RData")

#####################################
# bcr groups
##################################


dir.create("BCR")

#Mark the lowly expressed genes 
data.use=data.num
rownames(data.use)[which(rownames(data.use)%in%rownames(filtered))]=paste(rownames(data.use)[which(rownames(data.use)%in%rownames(filtered))], " ** LowExpr", sep = "")

#Normalize
data.use.norm <- edgeR::calcNormFactors(DGEList(counts=data.use))
data.use.norm=edgeR::cpm(data.use.norm, normalized.lib.sizes=T)

# Define Benign and Cancer samples
benign.samps <- which(clinical$group == "Benign")
cancer.samps <- which(clinical$group == "Cancer")

data.benign=data.use.norm[,benign.samps]
data.cancer=data.use.norm[,cancer.samps]


#check the order
colnames(data.benign)
colnames(data.cancer)


data.ben=data.benign
data.ben[is.na(data.ben)]=0 #
data.ben=log2(data.ben+1) 

data.can=data.cancer
data.can[is.na(data.can)]=0
data.can=log2(data.can+1)

data.log.ratio=data.can-data.ben


#Match the order with clinical data
rownames(clin.data)=as.character(clin.data[,1])
clin.data=clin.data[colnames(data.log.ratio),]


#define groups
bcrPos.samples=which(clin.data$bcr2==1)
bcrNeg.samples=which(clin.data$bcr2==0)
groups=rep(2, ncol(data.log.ratio))
groups[bcrPos.samples]=1


data.test=na.omit(data.log.ratio)
rots.res<- ROTS(data.test, groups=groups, B=1000,  K = nrow(data.log.ratio)/4, seed=1, progress=TRUE, log = T, paired = F)
rots.res.df=data.frame(d=rots.res$d, logfc=rots.res$logfc, pvalue=rots.res$pvalue, fdr=rots.res$FDR)

#save the results
rots.res.df=rots.res.df[order(as.numeric(rots.res.df$pvalue)),]
write.xlsx(rots.res.df, file = "BCR/data.log.ratio_All_Genes.xlsx", sheetName = "1", rowNames=TRUE)

save.image("2_Ratio_Data_BCR_Groups_DE_ROTS.RData")

